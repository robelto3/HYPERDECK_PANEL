[Unit]
Description=HyperDeck Control Panel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hyperdeck
WorkingDirectory=/home/hyperdeck/hyperdeck_panel
ExecStart=/home/hyperdeck/hyperdeck_panel/.venv/bin/python /home/hyperdeck/hyperdeck_panel/app.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
