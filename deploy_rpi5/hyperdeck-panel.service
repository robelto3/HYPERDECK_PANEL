[Unit]
Description=HyperDeck Control Panel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hyperdeck
WorkingDirectory=/home/hyperdeck/hyperdeck-panel
ExecStart=/usr/bin/python3 /home/hyperdeck/hyperdeck-panel/app.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
